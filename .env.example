# Variables d'environnement de l'app Biirb.
# Copier ce fichier en .env.local (ignoré par git) puis remplir les valeurs :
#   cp .env.example .env.local
# Ne jamais committer de vraie valeur : ce fichier ne contient que des exemples.

# --- Base de données : Cloud SQL (Postgres sur GCP) --------------------------
# Connexion en authentification IAM : AUCUN mot de passe de base. En local, se connecter une fois avec
#   gcloud auth application-default login
# (le compte Google doit avoir le rôle brb_admin ou brb_app sur l'instance).

# Nom de connexion de l'instance : projet:région:instance (celle de l'équipe, ce n'est pas un secret).
# Lue par : src/server/config.ts → src/server/infra/db.ts, et scripts/seed.mts
CLOUD_SQL_INSTANCE=biirb-511608:europe-west9:biirb-db1

# Utilisateur IAM de la base (ton email Google en local, le compte de service sur Cloud Run).
# Lue par : src/server/config.ts → src/server/infra/db.ts, et scripts/seed.mts
DB_USER=prenom.nom@example.com

# Nom de la base. Lue par : src/server/config.ts → src/server/infra/db.ts, et scripts/seed.mts
DB_NAME=brb

# --- Production (Cloud Run) -----------------------------------------------------
# URL publique du site : seule origine autorisée par CORS sur l'API (lue AU BUILD par next.config.ts),
# et seule base des liens envoyés par email (lue au démarrage par src/server/config.ts → getMailConfig).
# En production : build Docker ET variable Cloud Run, dans .github/workflows/deploy.yml. Inutile en local.
# APP_URL=https://brb-105103278561.europe-west9.run.app

# --- Authentification ----------------------------------------------------------

# Secret de signature des JWT (HS256). SERVEUR UNIQUEMENT, 32 caractères minimum (sinon l'app refuse de signer).
# Générer une valeur : openssl rand -base64 48
# Lue par : src/server/config.ts → src/server/jwt.ts
JWT_SECRET=change-me-with-at-least-32-random-characters

# Secret de signature des refresh tokens (HS256), DIFFÉRENT de JWT_SECRET. SERVEUR UNIQUEMENT, 32 caractères minimum.
# Générer une valeur : openssl rand -base64 48
# Lue par : src/server/config.ts → src/server/jwt.ts
JWT_REFRESH_SECRET=change-me-with-another-32-random-characters

# Durée de vie d'un token de connexion : nombre + unité (s, m, h, d). Passé ce délai, il faut se reconnecter.
# Optionnelle (défaut : 1h). Lue par : src/server/config.ts → src/server/jwt.ts
JWT_EXPIRES_IN=1h

# Durée de vie absolue d'une session (refresh token) : « Se souvenir de moi » coché (en jours, 1 à 90)
# ou non (en heures, 1 à 168). Optionnelles (défauts : 30 jours / 24 h).
# Lues par : src/server/config.ts → src/server/services/auth.service.ts
REFRESH_TOKEN_REMEMBER_DAYS=30
REFRESH_TOKEN_SESSION_HOURS=24

# Coût du hachage bcrypt des mots de passe, entre 10 et 14 (règle du projet : ≥ 10).
# +1 = deux fois plus lent pour un attaquant… et pour chaque connexion. Optionnelle (défaut : 12).
# Lue par : src/server/config.ts → src/server/services/auth.service.ts
BCRYPT_SALT_ROUNDS=12

# --- IA (planificateur) : Gemini sur Vertex AI ------------------------------------
# Authentification IAM comme la base (gcloud auth application-default login) : AUCUNE clé API.
# Le compte Google doit avoir le rôle roles/aiplatform.user sur le projet. Lues par : src/server/config.ts (utilisées par src/server/infra/ai.ts)
GCP_PROJECT_ID=biirb-511608
VERTEX_LOCATION=europe-west9

# --- Rate limiting (anti-bruteforce / anti-abus) ------------------------------
# Nombre maximum de requêtes autorisées par fenêtre (en secondes). Au-delà : 429 Too Many Requests.
# Compteurs en mémoire, remis à zéro au redémarrage du serveur. Toutes optionnelles (défauts ci-dessous).
# Lues par : src/server/config.ts → controllers

# Nombre de proxys de confiance devant l'app (1 à 5, défaut : 1 = Cloud Run). Sert à lire la vraie IP du
# client dans X-Forwarded-For : seules les dernières entrées (ajoutées par ces proxys) sont fiables, les
# premières peuvent être inventées par le client pour contourner le rate limit. Lue par : src/server/rateLimit.ts
TRUSTED_PROXY_HOPS=1

# Connexion, par IP (défaut : 5 essais / 15 min)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# Connexion, par compte visé (email), quelle que soit l'IP : bruteforce réparti (défaut : 10 / 15 min)
RATE_LIMIT_LOGIN_EMAIL_MAX=10
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900

# Renouvellement de session POST /api/v1/auth/refresh, par IP (défaut : 300 / 15 min ; un refresh à chaque chargement de page,
# l'access token n'étant gardé qu'en mémoire ; plusieurs utilisateurs peuvent partager une IP, ex. wifi d'école)
RATE_LIMIT_REFRESH_MAX=300
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900

# Inscription, par IP (défaut : 5 / 15 min)
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=900

# Mot de passe oublié POST /api/v1/auth/forgot-password : par IP (défaut : 5 / 15 min)
# et par email visé, contre l'envoi en masse dans une même boîte (défaut : 3 / heure)
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=900
RATE_LIMIT_FORGOT_PASSWORD_EMAIL_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_EMAIL_WINDOW_SECONDS=3600

# Nouveau mot de passe POST /api/v1/auth/reset-password, par IP (défaut : 10 / 15 min)
RATE_LIMIT_RESET_PASSWORD_MAX=10
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=900

# Recherche de lieux GET /api/v1/locations, par IP (défaut : 60 / min)
RATE_LIMIT_LOCATIONS_MAX=60
RATE_LIMIT_LOCATIONS_WINDOW_SECONDS=60

# Lecture du feed GET /api/v1/posts (chargement infini), par IP (défaut : 120 / min)
RATE_LIMIT_FEED_MAX=120
RATE_LIMIT_FEED_WINDOW_SECONDS=60

# Création de post POST /api/v1/posts, par utilisateur (défaut : 10 / heure)
RATE_LIMIT_POST_CREATE_MAX=10
RATE_LIMIT_POST_CREATE_WINDOW_SECONDS=3600

# Masquer / supprimer un post PATCH et DELETE /api/v1/posts/{id}, par utilisateur (défaut : 30 / 15 min)
RATE_LIMIT_POST_EDIT_MAX=30
RATE_LIMIT_POST_EDIT_WINDOW_SECONDS=900

# Likes / enregistrements PUT et DELETE /api/v1/posts/{id}/like|save, par utilisateur (défaut : 60 / min)
RATE_LIMIT_POST_REACT_MAX=60
RATE_LIMIT_POST_REACT_WINDOW_SECONDS=60

# Consultation d'un profil public GET /api/v1/users/{pseudo}, par IP (défaut : 120 / min)
RATE_LIMIT_PROFILE_VIEW_MAX=120
RATE_LIMIT_PROFILE_VIEW_WINDOW_SECONDS=60

# Modification du profil PATCH /api/v1/users/me, par utilisateur (défaut : 10 / 15 min)
RATE_LIMIT_PROFILE_UPDATE_MAX=10
RATE_LIMIT_PROFILE_UPDATE_WINDOW_SECONDS=900

# Signalement d'un post POST /api/v1/posts/{id}/report, par utilisateur (défaut : 10 / heure)
RATE_LIMIT_REPORT_MAX=10
RATE_LIMIT_REPORT_WINDOW_SECONDS=3600

# Création d'un ticket de support POST /api/v1/tickets, par utilisateur (défaut : 5 / heure)
RATE_LIMIT_TICKET_MAX=5
RATE_LIMIT_TICKET_WINDOW_SECONDS=3600

# Commentaires POST /api/v1/posts/{id}/comments, par utilisateur (défaut : 20 / 15 min)
RATE_LIMIT_COMMENT_MAX=20
RATE_LIMIT_COMMENT_WINDOW_SECONDS=900

# Routes d'administration /api/v1/admin/*, par administrateur (défaut : 120 / min)
RATE_LIMIT_ADMIN_MAX=120
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60

# Quota d'appels à l'IA par utilisateur et par jour (heure de Paris), admins exclus, lu par src/server/config.ts
# (ai-quota.service.ts ; affiché dans l'admin). Défaut : 15
AI_DAILY_LIMIT_PER_USER=15
# Même quota, plafond plus haut pour les appels faits sur un voyage qui a le pass voyage. Lu par src/server/config.ts
# (ai-quota.service.ts). Défaut : 50
AI_DAILY_LIMIT_TRIP_PASS=50

# IA du planificateur, par utilisateur, lus par src/server/config.ts (trip.controller.ts) :
# génération / régénération d'un voyage (défaut : 20 / h)
RATE_LIMIT_TRIP_AI_MAX=20
RATE_LIMIT_TRIP_AI_WINDOW_SECONDS=3600
# messages de la discussion avec l'IA (défaut : 30 / h)
RATE_LIMIT_TRIP_CHAT_MAX=30
RATE_LIMIT_TRIP_CHAT_WINDOW_SECONDS=3600
# Partage d'un voyage (invitations par pseudo ou lien, liens rejoints), par utilisateur (défaut : 30 / 15 min)
RATE_LIMIT_TRIP_SHARE_MAX=30
RATE_LIMIT_TRIP_SHARE_WINDOW_SECONDS=900
# Écritures sur les dépenses d'un voyage (dépenses, participants, remboursements, « à payer »), par utilisateur (défaut : 120 / 15 min)
RATE_LIMIT_TRIP_EXPENSE_MAX=120
RATE_LIMIT_TRIP_EXPENSE_WINDOW_SECONDS=900
# Exports PDF / .ics et commandes du pass voyage, par utilisateur (défaut : 20 / 15 min) : un PDF se calcule sur l'unique instance
RATE_LIMIT_TRIP_EXPORT_MAX=20
RATE_LIMIT_TRIP_EXPORT_WINDOW_SECONDS=900

# --- Rôle mécène : Buy Me a Coffee ------------------------------------------------
# Les deux sont optionnelles : absentes ou invalides, la page /patron affiche « paiement indisponible »
# (le reste de l'app fonctionne ; une valeur invalide est signalée dans les logs).

# Page Buy Me a Coffee de l'équipe (https://buymeacoffee.com/<pseudo>). Non secrète.
# Lue par : src/server/config.ts (getBuyMeACoffeeConfig) → src/server/services/patron.service.ts
# BMC_PAGE_URL=https://buymeacoffee.com/xxx

# Secret de signature du webhook. SERVEUR UNIQUEMENT.
# Buy Me a Coffee → Integrations → Webhooks → New webhook : URL https://<site>/api/v1/payments/buymeacoffee,
# événements donation.created, donation.refunded, extra_purchase.created et extra_purchase.refunded ; le secret est sur la page du webhook.
# Lue par : src/server/config.ts (getBuyMeACoffeeConfig) → src/server/services/patron.service.ts
# BMC_WEBHOOK_SECRET=xxx

# Don minimum en euros pour obtenir le rôle (= prix d'un café sur la page). Optionnelle (défaut : 5).
# Un don plus petit ou dans une autre devise est reçu par Buy Me a Coffee mais ne donne pas le rôle.
# Lue par : src/server/config.ts (getBuyMeACoffeeConfig) → src/server/services/patron.service.ts
BMC_PATRON_MIN_EUR=5

# --- Pass voyage : article « Extra » de la boutique Buy Me a Coffee ----------------
# Optionnelles : absentes ou invalides, le pass n'est pas en vente (le reste fonctionne). Nécessitent BMC_WEBHOOK_SECRET.
# Le pass est rattaché au compte Brb de même email que l'achat, pour le dernier voyage choisi (24 h).
# Lues par : src/server/config.ts (getBuyMeACoffeeConfig) → src/server/services/trip-pass.service.ts

# Lien de l'article (https://buymeacoffee.com/<pseudo>/e/<id>). Non secret.
# BMC_TRIP_PASS_URL=https://buymeacoffee.com/xxx/e/123456
# Identifiant de l'article (le nombre à la fin du lien) : un achat d'un autre article ne donne pas le pass.
# BMC_TRIP_PASS_EXTRA_ID=123456
# Prix en euros (affiché, et minimum payé pour obtenir le pass). Défaut : 9.99
BMC_TRIP_PASS_PRICE_EUR=9.99
# --- Emails (mot de passe oublié) : Gmail en SMTP ---------------------------------
# Optionnelles : absentes ou invalides, « mot de passe oublié » répond « envoi indisponible »
# (le reste de l'app fonctionne ; une valeur invalide est signalée dans les logs).
# Lues par : src/server/config.ts (getMailConfig) → src/server/infra/mailer.ts

# Adresse Gmail dédiée au projet (expéditeur des emails). Non secrète.
# SMTP_USER=brb.app@gmail.com

# Mot de passe d'application Google (16 lettres) : Compte Google → Sécurité → Validation en deux étapes
# → Mots de passe des applications. SECRET : jamais le vrai mot de passe du compte, révocable à tout moment.
# En production : Secret Manager (brb-smtp-password).
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Durée de validité du lien de réinitialisation, en minutes (5 à 120, défaut : 30).
# Lue par : src/server/config.ts → src/server/services/password-reset.service.ts
PASSWORD_RESET_TTL_MINUTES=30
